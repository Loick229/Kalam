# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- IA pour les fiches de résumé (console.anthropic.com → API Keys) ---
# Facultatif : sans clé, le bouton « Proposer un résumé » est simplement désactivé.
ANTHROPIC_API_KEY=sk-ant-...

# --- Accès ---
# Mettre "false" une fois votre compte créé : plus personne ne pourra s'inscrire.
NEXT_PUBLIC_ALLOW_SIGNUP=true
